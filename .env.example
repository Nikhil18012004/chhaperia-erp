# ============================================================
# Chhaperia ERP — project configuration TEMPLATE
#
# Copy to `.env` in this same folder and fill it in. The real .env is
# gitignored and never leaves the machine.
#
# WHY A FILE AND NOT MACHINE-WIDE VARIABLES
# The environment is shared by every program on the box. A DATABASE_URL or
# PORT set for some other project is visible to this one too, which is how an
# application ends up writing into a database that is not its own. Everything
# this ERP reads is named CHHAPERIA_* and read from HERE, so the project's
# data — and the project's configuration — stay inside the project.
# Anything already exported in the real environment still wins; this file only
# fills in what is missing.
# ============================================================

# ---- the database this project owns (and only this one) ----
# Only read by docker-compose.yml, to initialise the database container the
# first time it starts. A server that talks to a MySQL somebody else installed
# does not need it.
CHHAPERIA_DB_ROOT_PASSWORD=
CHHAPERIA_DB_HOST=127.0.0.1
CHHAPERIA_DB_PORT=3306
CHHAPERIA_DB_USER=chhaperia
CHHAPERIA_DB_PASSWORD=
# Its own schema. The app refuses to install its tables into a schema that
# already holds another application's — see backend/src/db/connection.js.
CHHAPERIA_DB_NAME=chhaperia_erp
# Required when the database is not on this machine.
#CHHAPERIA_DB_SSL=true
#CHHAPERIA_DB_SSL_CA=/path/to/ca.pem
# A managed provider's single connection string, if you use one. The bare
# DATABASE_URL is deliberately NOT read — it is shared with everything else
# on the machine.
#CHHAPERIA_DB_URL=mysql://user:pass@host:3306/chhaperia_erp

# ---- the server ----
# Signs every login token: `openssl rand -hex 32`, then keep it. Changing it
# logs everyone out. Mandatory when NODE_ENV=production.
AUTH_SECRET=
PORT=4000
#NODE_ENV=production

# ---- files ----
# Every file this project writes (BarTender hand-off CSVs, the TDS booklet)
# goes under this directory. Defaults to <repo>/data — override it only for a
# mounted volume, never to a shared location like the system temp folder.
#CHHAPERIA_DATA_DIR=/data
