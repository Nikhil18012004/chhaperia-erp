# Dependencies
node_modules/
**/node_modules/

# Runtime database (SQLite) — NEVER commit: it holds real product/BOM/TDS
# data plus password hashes. Deploys/clones auto-seed on first request;
# real data is restored via the catalogue CSVs / tools/import-bom.js.
*.db
*.db-wal
*.db-shm
*.sqlite

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Logs / temp
*.log
npm-debug.log*
/tmp/
*.tmp

# Local scratch / parsing helpers (not part of the app)
parse*.py
sample_colors.py
*_home.html
prod_*.html
homepage.html
tapes_home.html
state_check.json
rt*.json

# Build artifacts
dist/
build/

# Local DB backups & test copies (safety snapshots, not part of the app)
_backup/
_testdata/

# Demo-layer manifests: a record of which rows THIS machine's database holds,
# written by tools/temp-demo and tools/demo-data.js. Local state, not source.
data/temp-demo-manifest.json
data/demo-manifest.json

# Env
.env
.env.local
data/bartender/
run-local.cmd
backups/

# Machine-to-machine data exchange (tools/erp-export.js, tools/erp-import.js).
# These files ARE the live business data — costs, prices, customers, suppliers,
# staff pay. This repository is public, and git keeps deleted content forever,
# so the exchange folder is carried across by hand (shared drive, USB) and
# never committed.
data/exchange/
